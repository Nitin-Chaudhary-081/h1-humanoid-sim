<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>h1_bringup</name>
  <version>0.1.0</version>
  <description>Composition root: headless H1 sim bringup (Gazebo Harmonic server-only, Foxglove bridge, robot state publisher)</description>
  <maintainer email="robot-agent@example.com">robot-agent</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ros2launch</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>robot_state_publisher</depend>
  <depend>foxglove_bridge</depend>
  <depend>ros_gz_h1_description</depend>
  <depend>ros_gz_h1_gazebo</depend>

  <exec_depend>ros_gz_h1_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
