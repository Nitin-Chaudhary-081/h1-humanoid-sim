<mujoco model="h1_stand_proxy">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <worldbody>
    <light name="top" pos="0 0 2" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="3 3 0.1" friction="1.0"/>
    <body name="torso" pos="0 0 0">
      <joint name="torso_z" type="slide" axis="0 0 1" range="0 1.4"/>
      <joint name="torso_pitch" type="hinge" axis="0 1 0" range="-10 10"/>
      <geom name="torso_geom" type="box" size="0.08 0.06 0.15" mass="7"/>
      <body name="leg_left" pos="0 0.06 -0.15">
        <joint name="hip_left" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
        <geom name="thigh_l" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.03" mass="2"/>
        <body name="shank_left" pos="0 0 -0.32">
          <joint name="knee_left" type="hinge" axis="0 1 0" range="-1.4 0"/>
          <geom name="shank_l" type="capsule" fromto="0 0 0 0 0 -0.30" size="0.025" mass="1.5"/>
          <geom name="foot_l" type="box" pos="0 0 -0.33" size="0.06 0.04 0.02" mass="0.5"/>
        </body>
      </body>
      <body name="leg_right" pos="0 -0.06 -0.15">
        <joint name="hip_right" type="hinge" axis="0 1 0" range="-1.0 1.0"/>
        <geom name="thigh_r" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.03" mass="2"/>
        <body name="shank_right" pos="0 0 -0.32">
          <joint name="knee_right" type="hinge" axis="0 1 0" range="-1.4 0"/>
          <geom name="shank_r" type="capsule" fromto="0 0 0 0 0 -0.30" size="0.025" mass="1.5"/>
          <geom name="foot_r" type="box" pos="0 0 -0.33" size="0.06 0.04 0.02" mass="0.5"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- Order must match action vector: [hip_l, knee_l, hip_r, knee_r, flip] -->
    <motor name="hip_left" joint="hip_left" gear="50"/>
    <motor name="knee_left" joint="knee_left" gear="50"/>
    <motor name="hip_right" joint="hip_right" gear="50"/>
    <motor name="knee_right" joint="knee_right" gear="50"/>
    <motor name="torso_pitch" joint="torso_pitch" gear="100"/>
  </actuator>
</mujoco>
