# Grasp execution action
# Goal: target marker ID and grasp parameters
# Result: success flag and executed trajectory
# Feedback: current phase and progress

int32 target_marker_id
float64 pregrasp_offset
float64 grasp_depth
---
bool success
trajectory_msgs/JointTrajectory trajectory
string message
---
string phase  # "approaching", "grasping", "retreating", "completed"
float64 progress  # 0.0 to 1.0