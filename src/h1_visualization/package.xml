<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>h1_visualization</name>
  <version>0.1.0</version>
  <description>M2/M3: Foxglove layout, markers for /h1/control_state, goal visualization</description>
  <maintainer email="robot-agent@example.com">robot-agent</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>h1_interfaces</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
